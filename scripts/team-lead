#!/usr/bin/env bash
# Start Claude in team lead mode (docs/way-of-working.md §8), for hard problems: the owner is the PO.
# Refuses in a linked worktree, and while a session named po or team-lead runs (the two modes never run at once).
set -euo pipefail

cd "$(dirname "$0")/.."

if [ "$(git rev-parse --absolute-git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
  echo "team-lead: run this in the main checkout, not in a worktree." >&2
  exit 2
fi

running=$(claude agents --json | python3 -c 'import json, sys
names = {a.get("name") for a in json.load(sys.stdin)}
print(" ".join(n for n in ("po", "team-lead") if n in names))')
if [ -n "$running" ]; then
  echo "team-lead: a session named $running is already running; PO mode and team lead mode never run at once." >&2
  exit 2
fi

exec claude --agent team-lead -n team-lead "$@"
